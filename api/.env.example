# Copy this file to api/.env for local development.
# Never put real credentials in this tracked template.
APP_ENV=development

# Local-only fallback is allowed in development; use a unique random secret in production.
JWT_SECRET=replace-with-a-random-local-development-secret

# Database settings (match the names used by api/db.php if configured there).
DB_HOST=127.0.0.1
DB_NAME=bookkam
DB_USER=root
DB_PASSWORD=

# Optional integrations; leave disabled unless using real test credentials.
GOOGLE_CLIENT_ID=
TERMII_API_KEY=
TERMII_SENDER_ID=BOOKKAM

OPAY_ENABLED=false
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
BOOKKAM_WHATSAPP_SUPPORT=2349164812347

CLOUDINARY_CLOUD=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=bookkam_uploads
