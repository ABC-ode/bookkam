# Template only. Copy to api/.env and replace placeholders before running.
# Never commit real credentials. Do not deploy with placeholder values.
# APP_ENV: only development|local|test|testing enable test behaviour (fixed OTP, simulator, test top-ups).
# Anything else (unset, 'prod', 'staging', ...) is treated as production. Keep 'production' on the live server.
APP_ENV=production

# Optional: enables the secret-URL admin portal. Use a long random value; never reuse the exposed old key.
# At least 16 characters; a REPLACE_WITH... placeholder keeps the portal disabled.
ADMIN_PORTAL_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required in production (>= 32 chars; a REPLACE_WITH... placeholder is rejected). Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Database settings (verify names against the active database bootstrap).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookkam
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD

# Optional integrations; leave blank unless configured with real credentials.
GOOGLE_CLIENT_ID=
TERMII_API_KEY=
TERMII_SENDER_ID=BOOKKAM

# Keep real payments disabled until the OPay integration is validated.
OPAY_ENABLED=false
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
BOOKKAM_WHATSAPP_SUPPORT=2349164812347

CLOUDINARY_CLOUD=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=bookkam_uploads
