# Template only. Copy to api/.env and replace placeholders before running.
# Never commit real credentials. Do not deploy with placeholder values.
# APP_ENV: only development|local|test|testing enable test behaviour (simulator, test top-ups, file mail transport).
# Anything else (unset, 'prod', 'staging', ...) is treated as production. Keep 'production' on the live server.
APP_ENV=production

# Optional: enables the secret-URL admin portal. Use a long random value; never reuse the exposed old key.
# At least 16 characters; a REPLACE_WITH... placeholder keeps the portal disabled.
ADMIN_PORTAL_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required in production (>= 32 chars; a REPLACE_WITH... placeholder is rejected). Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Database settings (verify names against the active database bootstrap).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookkam
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD

# Optional integrations; leave blank unless configured with real credentials.
GOOGLE_CLIENT_ID=
# Tests only (ignored unless APP_ENV is a test value): stub for Google's token verification endpoint.
GOOGLE_TOKENINFO_URL=

# OPay Checkout (Cashier). Keep OPAY_ENABLED=false until a sandbox payment has been completed end to end.
# OPAY_ENV=sandbox uses OPay's sandbox API; set production only with live keys. Keys: OPay merchant dashboard > API keys & webhooks.
# OPAY_PUBLIC_KEY signs nothing (it authorises payment creation); OPAY_SECRET_KEY signs status queries and verifies callbacks.
OPAY_ENABLED=false
OPAY_ENV=sandbox
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
BOOKKAM_WHATSAPP_SUPPORT=2349164812347

CLOUDINARY_CLOUD=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=bookkam_uploads

# Public site address used to build the links in verification / password-reset e-mails (no trailing slash).
APP_URL=https://REPLACE_WITH_YOUR_SITE_ADDRESS

# Outgoing e-mail. MAIL_TRANSPORT: smtp (recommended; use a mailbox on your domain), mail (PHP mail()), or file (tests only).
# For smtp: SMTP_ENCRYPTION=tls (STARTTLS, port 587) or ssl (port 465). 'none' is accepted for localhost only.
MAIL_TRANSPORT=smtp
MAIL_FROM=
MAIL_FROM_NAME=BOOKKAM
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
MAIL_OUTBOX_DIR=

# Failed-login limits (per account / per IP) inside the window in seconds. Defaults shown; all optional.
LOGIN_MAX_FAILS=8
LOGIN_IP_MAX_FAILS=40
LOGIN_WINDOW=900

# One-time 1000 NGN welcome credit for a customer who verifies an e-mail address or signs in with Google.
# OFF by default: e-mail addresses are free to create, so enabling it lets one person claim it repeatedly with new addresses.
WELCOME_CREDIT_ENABLED=0
